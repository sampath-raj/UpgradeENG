# Backend
SECRET_KEY=change_me_to_a_random_32_character_string_minimum
ENVIRONMENT=development

# Anthropic (required for all AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Frontend
VITE_API_URL=http://localhost:8000
